@model List<AquariumStore.Models.Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Lịch sử đơn hàng của bạn</h3>
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-bag-plus me-1"></i>Mua thêm sản phẩm
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-receipt text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">Chưa có đơn hàng nào</h4>
            <p class="text-muted small">Hãy chọn những chú cá cảnh hoặc cây thủy sinh yêu thích để bắt đầu.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-grid me-1"></i>Khám phá sản phẩm
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Ngày đặt</th>
                            <th>Số mặt hàng</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var badgeClass = order.Status switch
                            {
                                "Chờ xử lý" => "bg-warning text-dark",
                                "Đã xác nhận" => "bg-info text-dark",
                                "Đang giao" => "bg-primary",
                                "Hoàn thành" => "bg-success",
                                "Đã hủy" => "bg-danger",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td class="fw-bold">#@order.OrderId</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.OrderDetails.Sum(x => x.Quantity) sản phẩm</td>
                                <td class="text-danger fw-bold">@order.TotalAmount.ToString("N0") ₫</td>
                                <td>@order.PaymentMethod</td>
                                <td><span class="badge @badgeClass">@order.Status</span></td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                    @if (order.Status == "Chờ xử lý")
                                    {
                                        <form asp-action="Cancel" asp-route-id="@order.OrderId" method="post" class="d-inline"
                                              onsubmit="return confirm('Hủy đơn hàng #@order.OrderId?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Hủy đơn">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
