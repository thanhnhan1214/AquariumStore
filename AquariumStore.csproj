<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Nhắm tới nền tảng .NET 10.0 -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Bật kiểm tra kiểu tham chiếu có thể null (Nullable Reference Types) -->
    <Nullable>enable</Nullable>
    <!-- Tự động nạp các namespace cơ bản của C# và ASP.NET Core -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gói công cụ thiết kế hỗ trợ tạo Migration cho Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Provider kết nối hệ quản trị cơ sở dữ liệu Microsoft SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Gói lệnh CLI/PMC (Add-Migration, Update-Database) cho EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Bản vá bảo mật mới nhất cho thư viện mã hóa PKCS -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
