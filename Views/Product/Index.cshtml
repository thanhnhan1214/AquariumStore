@model List<AquariumStore.Models.Product>
@{
    ViewData["Title"] = ViewBag.Title ?? "Sản phẩm";
    var categories = ViewBag.Categories as List<AquariumStore.Models.Category>;
    int? currentCategoryId = ViewBag.CurrentCategoryId as int?;
    string? currentSearch = ViewBag.CurrentSearch as string;
    string currentSort = (ViewBag.CurrentSort as string) ?? "newest";
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
    bool inStockOnly = (ViewBag.InStockOnly as bool?) ?? false;
    var totalActiveCount = categories?.Sum(c => c.Products?.Count(p => p.IsActive) ?? 0) ?? 0;
    var bestSellers = ViewBag.BestSellers as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item active">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="row g-4">
    <!-- SIDEBAR LỌC ĐA TIÊU CHÍ -->
    <div class="col-lg-3">
        <!-- Danh mục -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white fw-semibold">
                <i class="bi bi-list-ul me-2"></i>Danh mục sản phẩm
            </div>
            <div class="list-group list-group-flush">
                <a asp-action="Index"
                   asp-route-search="@currentSearch"
                   asp-route-sortBy="@currentSort"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(currentCategoryId == null ? "active" : "")">
                    <span><i class="bi bi-grid-3x3-gap me-2"></i>Tất cả danh mục</span>
                    <span class="badge @(currentCategoryId == null ? "bg-light text-primary" : "bg-secondary bg-opacity-25 text-dark") rounded-pill">@totalActiveCount</span>
                </a>
                @if (categories != null)
                {
                    @foreach (var cat in categories)
                    {
                        var count = cat.Products?.Count(p => p.IsActive) ?? 0;
                        var isActive = currentCategoryId == cat.CategoryId;
                        <a asp-action="Index"
                           asp-route-categoryId="@cat.CategoryId"
                           asp-route-search="@currentSearch"
                           asp-route-sortBy="@currentSort"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isActive ? "active" : "")">
                            <span>@cat.CategoryName</span>
                            <span class="badge @(isActive ? "bg-light text-primary" : "bg-secondary bg-opacity-25 text-dark") rounded-pill">@count</span>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Bộ lọc nâng cao -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-sliders text-primary me-2"></i>Bộ lọc nâng cao
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get">
                    @if (currentCategoryId.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@currentCategoryId" />
                    }
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Từ khóa</label>
                        <input type="text" name="search" value="@currentSearch" class="form-control form-control-sm" placeholder="Tên cá, cây, thiết bị..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Khoảng giá (VNĐ)</label>
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text">Từ</span>
                            <input type="number" name="minPrice" value="@minPrice" step="5000" min="0" class="form-control" placeholder="0" />
                        </div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Đến</span>
                            <input type="number" name="maxPrice" value="@maxPrice" step="10000" min="0" class="form-control" placeholder="1.000.000" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Sắp xếp theo</label>
                        <select name="sortBy" class="form-select form-select-sm">
                            <option value="newest" selected="@(currentSort == "newest")">Mới nhất</option>
                            <option value="price_asc" selected="@(currentSort == "price_asc")">Giá: Thấp đến Cao</option>
                            <option value="price_desc" selected="@(currentSort == "price_desc")">Giá: Cao đến Thấp</option>
                            <option value="name_asc" selected="@(currentSort == "name_asc")">Tên: A → Z</option>
                        </select>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="inStockOnly" value="true" id="inStockCheck" @(inStockOnly ? "checked" : "") />
                        <label class="form-check-label small" for="inStockCheck">
                            Chỉ hiển thị sản phẩm còn hàng
                        </label>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-funnel-fill me-1"></i>Áp dụng bộ lọc
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Xóa bộ lọc
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH SẢN PHẨM -->
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-bold mb-0">@ViewData["Title"]</h5>
                    <small class="text-muted">Tìm thấy <strong>@Model.Count</strong> sản phẩm phù hợp</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">Sắp xếp nhanh:</span>
                    <a asp-action="Index" asp-route-categoryId="@currentCategoryId" asp-route-search="@currentSearch" asp-route-sortBy="price_asc"
                       class="btn btn-sm @(currentSort == "price_asc" ? "btn-primary" : "btn-outline-secondary")">
                        <i class="bi bi-sort-numeric-down"></i> Giá tăng
                    </a>
                    <a asp-action="Index" asp-route-categoryId="@currentCategoryId" asp-route-search="@currentSearch" asp-route-sortBy="price_desc"
                       class="btn btn-sm @(currentSort == "price_desc" ? "btn-primary" : "btn-outline-secondary")">
                        <i class="bi bi-sort-numeric-up-alt"></i> Giá giảm
                    </a>
                </div>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm text-center py-5">
                <div class="card-body">
                    <i class="bi bi-search text-muted" style="font-size: 3.5rem;"></i>
                    <h5 class="mt-3">Không tìm thấy sản phẩm phù hợp</h5>
                    <p class="text-muted small">Hãy thử thay đổi từ khóa hoặc xóa bớt điều kiện lọc giá.</p>
                    <a asp-action="Index" class="btn btn-primary btn-sm">Xem tất cả sản phẩm</a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model)
                {
                    var isHot = bestSellers.TryGetValue(product.ProductId, out int soldCount);
                    <div class="col-6 col-md-4">
                        <div class="card h-100 shadow-sm border-0 product-card @(isHot ? "hot-fire-card" : "")">
                            <div class="position-relative cursor-pointer product-img-stage" style="height: 205px; overflow: hidden;"
                                 onclick="window.open360Viewer('@product.ImageUrl', '@Html.Raw(product.ProductName.Replace("'", "\\'"))', '@Html.Raw(product.Category.CategoryName.Replace("'", "\\'"))', '@product.Price.ToString("N0") ₫', '/Product/Details/@product.ProductId')"
                                 title="Bấm vào ảnh để xoay 360 độ xem chi tiết">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.ProductName"
                                         class="w-100 h-100 product-img" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100">
                                        <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                                    </div>
                                }
                                @if (isHot)
                                {
                                    <div class="position-absolute top-0 start-0 m-2 z-2">
                                        <span class="hot-fire-badge">
                                            <span class="fire-icon-anim">🔥</span> HOT • @soldCount+
                                        </span>
                                    </div>
                                    <div class="fire-flames-bar" aria-hidden="true"></div>
                                }
                                <div class="position-absolute top-0 end-0 m-2 z-2">
                                    @if (product.StockQuantity <= 0)
                                    {
                                        <span class="badge bg-danger shadow-sm">Hết hàng</span>
                                    }
                                    else if (product.StockQuantity <= 5)
                                    {
                                        <span class="badge bg-warning text-dark shadow-sm">Sắp hết (@product.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-90 shadow-sm">Còn @product.StockQuantity</span>
                                    }
                                </div>
                                <div class="v360-trigger-pill"><i class="bi bi-arrow-repeat me-1"></i>Xem 360°</div>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-info bg-opacity-10 text-primary border border-info mb-2 align-self-start">
                                    @product.Category.CategoryName
                                </span>
                                <h6 class="card-title fw-bold mb-1">
                                    <a asp-action="Details" asp-route-id="@product.ProductId" class="text-dark text-decoration-none">
                                        @product.ProductName
                                    </a>
                                </h6>
                                <p class="text-muted small text-truncate-2 mb-2">@product.Description</p>
                                <p class="text-danger fw-bold fs-5 mt-auto mb-2">@product.Price.ToString("N0") ₫</p>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@product.ProductId"
                                       class="btn btn-outline-primary btn-sm flex-grow-1">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1">
                                        <input type="hidden" name="productId" value="@product.ProductId" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100"
                                                @(product.StockQuantity <= 0 ? "disabled" : "")>
                                            <i class="bi bi-cart-plus"></i> Mua
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
