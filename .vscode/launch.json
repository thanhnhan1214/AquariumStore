{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AquariumStore (dotnet run - http://localhost:5080)",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet run --launch-profile http",
            "cwd": "${workspaceFolder}",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "http://localhost:5080"
            }
        }
    ]
}
