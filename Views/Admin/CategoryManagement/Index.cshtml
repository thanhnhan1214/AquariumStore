@model List<AquariumStore.Models.Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-tags me-2"></i>Quản lý danh mục</h3>
    <a href="/Admin/CategoryManagement/Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Thêm danh mục
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CategoryId</td>
                        <td class="fw-semibold">@c.CategoryName</td>
                        <td class="text-muted small">@c.Description</td>
                        <td>
                            <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">
                                @(c.IsActive ? "Hoạt động" : "Tạm ẩn")
                            </span>
                        </td>
                        <td>
                            <a href="/Admin/CategoryManagement/Edit/@c.CategoryId" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <form action="/Admin/CategoryManagement/ToggleActive/@c.CategoryId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-@(c.IsActive ? "pause" : "play")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
