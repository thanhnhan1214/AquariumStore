@model AquariumStore.Models.Order
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.OrderId}";
    var badgeClass = Model.Status switch
    {
        "Chờ xử lý" => "bg-warning text-dark",
        "Đã xác nhận" => "bg-info text-dark",
        "Đang giao" => "bg-primary",
        "Hoàn thành" => "bg-success",
        "Đã hủy" => "bg-danger",
        _ => "bg-secondary"
    };

    var steps = new[] { "Chờ xử lý", "Đã xác nhận", "Đang giao", "Hoàn thành" };
    var currentStepIndex = Array.IndexOf(steps, Model.Status);
    var qrAmount = (long)Model.TotalAmount;
    var qrUrl = $"https://img.vietqr.io/image/MB-0817687979-compact2.png?amount={qrAmount}&addInfo=DH-{Model.OrderId}&accountName=LE%20THANH%20NHAN";
}

<nav aria-label="breadcrumb" class="mb-3 no-print">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="History">Lịch sử đơn hàng</a></li>
        <li class="breadcrumb-item active">Đơn hàng #@Model.OrderId</li>
    </ol>
</nav>

<!-- THANH TIẾN TRÌNH ĐƠN HÀNG -->
@if (Model.Status != "Đã hủy")
{
    <div class="card border-0 shadow-sm mb-4 no-print">
        <div class="card-body py-4">
            <div class="order-stepper">
                @for (int i = 0; i < steps.Length; i++)
                {
                    var stateClass = i < currentStepIndex ? "completed" : (i == currentStepIndex ? "active" : "");
                    var icon = i switch
                    {
                        0 => "bi-hourglass-split",
                        1 => "bi-clipboard-check",
                        2 => "bi-truck",
                        _ => "bi-patch-check-fill"
                    };
                    <div class="order-step @stateClass">
                        <div class="step-icon"><i class="bi @icon"></i></div>
                        <div class="small fw-semibold">@steps[i]</div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger d-flex align-items-center mb-4">
        <i class="bi bi-x-octagon-fill fs-4 me-2"></i>
        <div>Đơn hàng này đã bị <strong>hủy</strong>. Số lượng sản phẩm đã được hoàn trả về kho.</div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="mb-0 fw-bold"><i class="bi bi-receipt text-primary me-2"></i>Hóa đơn đặt hàng #@Model.OrderId</h5>
            <small class="text-muted">Ngày tạo: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @badgeClass fs-6 px-3 py-2">@Model.Status</span>
            <button type="button" onclick="window.print()" class="btn btn-outline-secondary btn-sm no-print">
                <i class="bi bi-printer me-1"></i>In hóa đơn
            </button>
            @if (Model.Status == "Chờ xử lý")
            {
                <form asp-action="Cancel" asp-route-id="@Model.OrderId" method="post" class="d-inline no-print"
                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng #@Model.OrderId không?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-x-circle me-1"></i>Hủy đơn hàng
                    </button>
                </form>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h6 class="fw-bold text-primary mb-2"><i class="bi bi-geo-alt me-1"></i>Thông tin nhận hàng</h6>
                    <p class="mb-1"><strong>SĐT người nhận:</strong> @Model.RecipientPhone</p>
                    <p class="mb-0"><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h6 class="fw-bold text-primary mb-2"><i class="bi bi-credit-card me-1"></i>Thanh toán & Vận chuyển</h6>
                    <p class="mb-1"><strong>Phương thức:</strong> @Model.PaymentMethod</p>
                    <p class="mb-0"><strong>Đóng gói:</strong> Bơm Oxy chuyên dụng & Thùng xốp bảo ôn</p>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.OrderDetails)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@d.ProductId" class="text-dark text-decoration-none">
                                    @d.Product.ProductName
                                </a>
                            </td>
                            <td class="text-end">@d.UnitPrice.ToString("N0") ₫</td>
                            <td class="text-center">@d.Quantity</td>
                            <td class="text-end text-danger fw-bold">@d.SubTotal.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold fs-5">
                        <td colspan="3" class="text-end">Tổng thanh toán:</td>
                        <td class="text-end text-danger">@Model.TotalAmount.ToString("N0") ₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (Model.PaymentMethod == "Chuyển khoản" && Model.Status != "Đã hủy" && Model.Status != "Hoàn thành")
        {
            <div class="alert alert-info border-info mt-3 mb-0 no-print">
                <div class="row align-items-center g-3">
                    <div class="col-sm-8">
                        <h6 class="fw-bold"><i class="bi bi-qr-code-scan me-1"></i>Mã QR Chuyển khoản thanh toán</h6>
                        <p class="mb-1"><strong>Ngân hàng:</strong> MB BANK — <strong>Số TK:</strong> <code>0817687979</code> (LE THANH NHAN)</p>
                        <p class="mb-0"><strong>Nội dung chuyển khoản:</strong> <code class="fw-bold">DH-@Model.OrderId</code> — <strong>Số tiền:</strong> <strong class="text-danger">@Model.TotalAmount.ToString("N0") ₫</strong></p>
                    </div>
                    <div class="col-sm-4 text-center">
                        <img src="@qrUrl" alt="VietQR" class="img-fluid rounded-3 shadow-sm bg-white p-2" style="max-width: 150px;" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>
